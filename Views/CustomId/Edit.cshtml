@model List<CustomIdElement>

@{
    var inventoryId = ViewBag.InventoryId;
}

<div class="container mt-4">

    <h3 class="mb-3">Custom ID</h3>

    <!-- PREVIEW -->
    <div class="alert alert-info">
        <strong>Preview:</strong> <span id="preview">---</span>
    </div>

    <!-- FORM -->
    <form method="post">
        <input type="hidden" name="inventoryId" value="@inventoryId" />

        <!-- ELEMENTS -->
        <div id="elements" class="list-group">

            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="list-group-item element d-flex align-items-center gap-3">

                    <!-- drag -->
                    <span class="drag-handle text-muted" style="cursor:grab;">↕</span>

                    <!-- type -->
                    <select name="[@i].Type" class="form-select type" style="max-width: 220px;">
                        @foreach (var t in Enum.GetValues(typeof(CustomIdElementType)))
                        {
                            <option value="@t" selected="@(Model[i].Type == (CustomIdElementType)t)">
                                @t
                            </option>
                        }
                    </select>

                    <!-- value -->
                    <div class="flex-grow-1 d-flex gap-2 align-items-center">

                        <input name="[@i].Value"
                               value="@Model[i].Value"
                               class="form-control value"
                               placeholder="Value / format (D3, yyyy, X5)" />

                        <!-- help -->
                        <span class="text-muted" title="Use D3, yyyy, X5 etc">?</span>

                        <!-- hidden order -->
                        <input type="hidden" name="[@i].Order" value="@i" class="order" />

                        <!-- remove -->
                        <button type="button" class="btn btn-outline-danger btn-sm remove">✕</button>

                    </div>

                </div>
            }

        </div>

        <!-- ADD -->
        <button type="button" id="add" class="btn btn-secondary mt-3">
            Add element
        </button>

        <!-- SAVE -->
        <button class="btn btn-success mt-3 ms-2">
            Save
        </button>

    </form>

</div>

<!-- SORTABLE -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

<script>

    const container = document.getElementById("elements");

    // ✅ drag & drop
    if (container) {
        new Sortable(container, {
            animation: 150,
            handle: ".drag-handle",
            onEnd: updateOrder
        });
    }

    // ➕ ADD
    document.getElementById("add").onclick = () => {
        const index = container.children.length;

        const html = `
        <div class="list-group-item element d-flex align-items-center gap-3">

            <span class="drag-handle text-muted">↕</span>

            <select name="[${index}].Type" class="form-select type" style="max-width: 220px;">
                <option value="Fixed">Fixed</option>
                <option value="Random20">20-bit random</option>
                <option value="Random32">32-bit random</option>
                <option value="Random6">6-digit random</option>
                <option value="Random9">9-digit random</option>
                <option value="Guid">GUID</option>
                <option value="DateTime">Date/time</option>
                <option value="Sequence">Sequence</option>
            </select>

            <div class="flex-grow-1 d-flex gap-2 align-items-center">

                <input name="[${index}].Value"
                       class="form-control value"
                       placeholder="Value / format" />

                <input type="hidden" name="[${index}].Order" value="${index}" class="order" />

                <button type="button" class="btn btn-outline-danger btn-sm remove">✕</button>

            </div>

        </div>`;

        container.insertAdjacentHTML("beforeend", html);

        updateOrder();
        updatePreview();
    };

    // ❌ REMOVE
    container.addEventListener("click", e => {
        if (e.target.classList.contains("remove")) {
            e.target.closest(".element").remove();
            updateOrder();
            updatePreview();
        }
    });

    // 🔢 ORDER UPDATE
    function updateOrder() {
        [...container.children].forEach((el, i) => {
            el.querySelector(".order").value = i;

            // 🔥 важно: обновляем name
            el.querySelectorAll("select, input").forEach(input => {
                if (input.name.includes(".Type"))
                    input.name = `[${i}].Type`;

                if (input.name.includes(".Value"))
                    input.name = `[${i}].Value`;

                if (input.name.includes(".Order"))
                    input.name = `[${i}].Order`;
            });
        });
    }

    // 👀 PREVIEW
    function updatePreview() {
        let result = "";

        document.querySelectorAll(".element").forEach(el => {
            const type = el.querySelector(".type").value;
            const val = el.querySelector(".value").value;

            if (type === "Fixed") result += val || "TXT";
            else if (type === "Sequence") result += "001";
            else if (type === "DateTime") result += "2025";
            else if (type === "Random6") result += "123456";
            else if (type === "Random9") result += "123456789";
            else if (type === "Guid") result += "xxxx";
            else result += "X";
        });

        document.getElementById("preview").innerText = result;
    }

    // live preview
    document.addEventListener("input", updatePreview);
    updatePreview();

</script>