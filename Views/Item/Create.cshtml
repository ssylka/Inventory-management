@using Inventory_Managment.Models.Directory
@model Item
<div class="d-flex align-items-center mb-3">
    <button type="button" class="btn btn-light me-5">
        <a href="/Inventory/Details/@Model.InventoryId#tab-items" style="text-decoration: none; color: black">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z" />
                <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z" />
            </svg>
        </a>
    </button>

    <h2>Create Item</h2>
</div>

<div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

<form method="post">
    <input type="hidden" asp-for="InventoryId" value="@ViewBag.InventoryId" />

    @{
        var inventory = ViewBag.Inventory as Inventory;
    }

    @foreach (var field in inventory.Fields.OrderBy(f => f.Order))
    {
        @if (field.Type == FieldType.Bool)
        {
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" name="@field.Slot" value="true" checked />
                <label class="form-check-label">@field.Name</label>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label>@field.Name</label>
                @if (field.Type == FieldType.Number)
                {
                    <input type="number" class="form-control" name="@field.Slot" />
                }
                else
                {
                    <input class="form-control" name="@field.Slot" />
                }
            </div>
        }
    }

    <div class="mb-3">
        <label class="form-label">Custom ID</label>
        <input asp-for="CustomId" class="form-control" placeholder="Auto-generated" />
        <span asp-validation-for="CustomId" class="text-danger"></span>
        <div class="form-text">Leave empty to auto-generate.</div>
    </div>

    <button class="btn btn-success">Save</button>
</form>