@model Inventory

<div class="d-flex align-items-center mb-3">
    <button type="button" class="btn btn-light me-3">
        <a asp-controller="Inventory" asp-action="Fields" asp-route-id="@Model.Id" style="text-decoration: none; color: black">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z" />
                <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z" />
            </svg>
        </a>
    </button>
    <h2>Edit Inventory</h2>

    <a href="/Inventory/Edit/@Model.Id"
       class="btn btn-light ms-auto me-1">
        Edit
    </a>
    <a href="/CustomId/Edit?inventoryId=@Model.Id" class="btn btn-warning me-1">
        Custom ID
    </a>
    <a href="/Item/Index?inventoryId=@Model.Id" class="btn btn-success">
        Open Items
    </a>
</div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatorId" />
    <input type="hidden" asp-for="xmin" />
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    <div class="mb-3">
        <label>Title</label>
        <input class="form-control" asp-for="Title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Description</label>
        <textarea class="form-control" asp-for="Description"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Is public?</label>
        <input class="form-control form-check-input ms-4" type="checkbox" asp-for="IsPublic"/>
        <span asp-validation-for="IsPublic" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Category?</label>
        <select asp-for="CategoryId" class="form-select">
            @foreach (var c in ViewBag.Categories)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Tags</label>
        <div id="tags-container">
            @for (int i = 0; i < Model.TagNames.Count; i++)
            {
                <div class="tag-item position-relative d-flex mb-1">
                    <input name="TagNames[@i]" value="@Model.TagNames[i]" class="form-control me-2" />
                    <button type="button" class="btn btn-danger btn-sm" onclick="removeTag(this)">×</button>
                </div>
            }
        </div>

        <button type="button" onclick="addTag()" class="btn btn-outline-secondary btn-sm">+ Add tag</button>

    </div>

    <div class="mb-3">
        <label>Image URL</label>
        <input type="text" asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Save</button>
</form>

<script>
    function addTag() {
        const container = document.getElementById("tags-container");
        const index = container.children.length;

        const div = document.createElement("div");
        div.className = "tag-item d-flex mb-1";

        div.innerHTML = `
            <input name="TagNames[${index}]" class="form-control me-2" />
            <button type="button" class="btn btn-danger btn-sm" onclick="removeTag(this)">×</button>
        `;

        container.appendChild(div);
    }

    function removeTag(button) {
        button.parentElement.remove();
        reindexTags();
    }

    function reindexTags() {
        const inputs = document.querySelectorAll("#tags-container input");

        inputs.forEach((input, i) => {
            input.name = `TagNames[${i}]`;
        });
    }

    document.addEventListener("input", async (e) => {
        if (!e.target.matches("#tags-container input")) return;

        const input = e.target;
        const value = input.value;

        if (!value) return;

        const res = await fetch(`/Inventory/GetTags?term=${value}`);
        const data = await res.json();

        showSuggestions(input, data);
    });

    function showSuggestions(input, tags) {
        removeSuggestions();

        const list = document.createElement("ul");
        list.className = "list-group position-absolute w-100 shadow";

        list.style.top = "100%";
        list.style.left = "0";
        list.style.zIndex = 1000;

        tags.forEach(tag => {
            const li = document.createElement("li");
            li.className = "list-group-item list-group-item-action";
            li.textContent = tag;

            li.onclick = () => {
                input.value = tag;
                list.remove();
            };

            list.appendChild(li);
        });

        input.parentElement.appendChild(list);
    }

    function removeSuggestions() {
        document.querySelectorAll(".list-group").forEach(x => x.remove());
    }

    document.addEventListener("click", (e) => {
        if (!e.target.closest(".tag-item")) {
            removeSuggestions();
        }
    });
</script>