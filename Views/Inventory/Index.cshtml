@model List<Inventory_Managment.Models.Inventory>

@{
    var tag = ViewBag.Tag as string;
    ViewData["Title"] = tag != null ? $"Tag: {tag}" : "Inventories";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}
@if (tag != null)
{
<div class="d-flex align-items-center me-3 text-center">

    <button type="button" class="btn btn-light me-3">
        <a asp-controller="Home" asp-action="Index" asp-append-version="true" style="text-decoration:none;color:black">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z" />
                <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z" />
            </svg>
        </a>
    </button>
    <h2>@Localizer["InventoriesTagged"] <span class="badge bg-secondary">@tag</span></h2>
</div>
}
else
{
    <h2 class="mb-3">@Localizer["Inventories"]</h2>
}

@if (!Model.Any())
{
    <p class="text-muted">@Localizer["NoInventoriesFound"]</p>
}
else
{
    <div class="table-responsive">
    <table class="table table-bordered table-striped table-hover align-middle text-center">
        <thead>
            <tr>
                <th class="w-25">@Localizer["Title"]</th>
                <th>@Localizer["Description"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model)
            {
                <tr>
                    <td class="inventory-row border" style="cursor:pointer;" data-id="@inv.Id">@inv.Title</td>
                    <td class="inventory-row markup" style="cursor:pointer;" data-id="@inv.Id">@inv.Description</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@if (User.IsInRole("Active") || User.IsInRole("Admin"))
{
    <a href="/Inventory/Create" class="btn btn-primary">@Localizer["NewInventory"]</a>
    <a class="btn btn-danger d-none" id="btnDelete">@Localizer["Delete"]</a>
}

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
<script>
    document.querySelectorAll(".inventory-row").forEach(row => {
        row.addEventListener("click", function () {
            window.location.href = `/Inventory/Details/${this.dataset.id}#tab-items`;
        });
    });

    document.querySelectorAll(".markup").forEach(t => {
        t.innerHTML = DOMPurify.sanitize(marked.parse(t.textContent.trim()));
    });
</script>
}
