@using Microsoft.AspNetCore.Identity
@inject UserManager<AppUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
}
<!DOCTYPE html>
@{
    var theme = Context.Request.Cookies["theme"] ?? "light";
}

<html lang="en" data-bs-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory_Managment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-body border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Inventory_Managment</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="Index">@Localizer["Inventories"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">@Localizer["Privacy"]</a>
                        </li>
                    </ul>

                    <input class="form-control me-lg-2 my-2 my-lg-0" type="text" id="searchInput"
                           value="@ViewBag.SearchText" placeholder="@Localizer["Searching..."]" style="max-width:260px"/>

                    <div class="d-flex align-items-center gap-2 my-2 my-lg-0 ms-lg-2">
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                🌐
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                        asp-controller="Language"
                                        asp-action="Set"
                                        asp-route-culture="ru"
                                        asp-route-returnUrl="@Context.Request.Path">
                                        <img src="https://flagcdn.com/w40/ru.png" width="20"> RU
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2"
                                        asp-controller="Language"
                                        asp-action="Set"
                                        asp-route-culture="en"
                                        asp-route-returnUrl="@Context.Request.Path">
                                        <img src="https://flagcdn.com/w40/gb.png" width="20"> EN
                                    </a>
                                </li>
                            </ul>
                        </div>

                        <button class="btn btn-secondary" onclick="toggleTheme()" id="theme-btn">🌙</button>

                        @if (User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Index">
                                    @Localizer["AdminPage"]
                                </a>
                            }
                            <a class="btn btn-outline-info" asp-controller="Account" asp-action="Profile" asp-route-id="@currentUser?.Id">
                                @currentUser?.Name
                            </a>
                            <a class="btn btn-outline-danger" asp-controller="Account" asp-action="Logout">
                                @Localizer["Logout"]
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">
                                @Localizer["Login"]
                            </a>
                            <a class="btn btn-primary" asp-controller="Account" asp-action="Register">
                                @Localizer["Register"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <script src="~/js/switch_theme.js" asp-append-version="true"></script>
    <script src="~/js/searching.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
