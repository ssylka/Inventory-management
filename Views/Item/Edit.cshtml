@using Inventory_Managment.Models.Directory
@model Item

<div class="d-flex align-items-center mb-3">
    <button type="button" class="btn btn-light me-3">
        <a href="/Inventory/Details/@Model.InventoryId#tab-items" style="text-decoration: none; color: black">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-backspace" viewBox="0 0 16 16">
                <path d="M5.83 5.146a.5.5 0 0 0 0 .708L7.975 8l-2.147 2.146a.5.5 0 0 0 .707.708l2.147-2.147 2.146 2.147a.5.5 0 0 0 .707-.708L9.39 8l2.146-2.146a.5.5 0 0 0-.707-.708L8.683 7.293 6.536 5.146a.5.5 0 0 0-.707 0z" />
                <path d="M13.683 1a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7.08a2 2 0 0 1-1.519-.698L.241 8.65a1 1 0 0 1 0-1.302L5.084 1.7A2 2 0 0 1 6.603 1zm-7.08 1a1 1 0 0 0-.76.35L1 8l4.844 5.65a1 1 0 0 0 .759.35h7.08a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1z" />
            </svg>
        </a>
    </button>
    <h2>@Localizer["EditItem"]</h2>
</div>

<form method="post" style="max-width:600px">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="InventoryId" />
    <input type="hidden" asp-for="xmin" />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @{
        var inventory = ViewBag.Inventory as Inventory;
    }

    @foreach (var field in inventory.Fields.OrderBy(f => f.Order))
    {
        var prop = Model.GetType().GetProperty(field.Slot);
        var value = prop?.GetValue(Model);

        @if (field.Type == FieldType.Bool)
        {
            var isChecked = value?.ToString() == "True";
            <div class="form-check mb-3">
                <input type="hidden" id="bool-value-@field.Slot" name="@field.Slot" value="@(isChecked ? "true" : "false")" />
                <input type="checkbox" class="form-check-input"
                       @(isChecked ? "checked" : "")
                       onchange="document.getElementById('bool-value-@field.Slot').value = this.checked ? 'true' : 'false'" />
                <label class="form-check-label">@field.Name</label>
            </div>
        }
        else if (field.Type == FieldType.Link)
        {
            var urlValue = value?.ToString();
            <div class="mb-3">
                <label class="form-label">@field.Name</label>

                <input type="hidden" name="@field.Slot" id="hidden-url-@field.Slot" />

                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <label class="btn btn-outline-secondary mb-0" style="cursor:pointer">
                        @Localizer["ChooseFile"]
                        <input type="file" id="file-input-@field.Slot" accept="image/*" class="d-none" />
                    </label>
                    <span id="status-@field.Slot" class="text-muted small"></span>
                </div>

                <div id="preview-wrapper-@field.Slot" class="mt-2 d-none">
                    <img id="preview-@field.Slot" src="" alt="Preview"
                         class="rounded border" style="max-height:200px;max-width:100%;object-fit:contain;" />
                    <button type="button" id="remove-btn-@field.Slot"
                            class="btn btn-sm btn-outline-danger ms-2">@Localizer["Remove"]</button>
                </div>
            </div>
        }
        else if (field.Type == FieldType.Number)
        {
            <div class="mb-3">
                <label class="form-label">@field.Name</label>
                <input type="number" class="form-control" name="@field.Slot" value="@value" />
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">@field.Name</label>
                <input class="form-control" name="@field.Slot" value="@value" />
            </div>
        }
    }

    <div class="mb-3">
        <label class="form-label">@Localizer["CustomID"]</label>
        <input class="form-control" name="CustomId" value="@Model.CustomId" />
    </div>

    <button class="btn btn-success" id="submit-btn">@Localizer["Save"]</button>

    <input type="hidden" name="CreatedAt" value="@Model.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")" />
    <input type="hidden" name="CustomId" value="@Model.CustomId" />
</form>

@section Scripts {
<script>
    const msgUploading    = @Json.Serialize(Localizer["Uploading"].Value);
    const msgUploaded     = @Json.Serialize(Localizer["Uploaded"].Value);
    const msgUploadFailed = @Json.Serialize(Localizer["UploadFailed"].Value);

    function initLinkUpload(slot, existingUrl) {
        let committedUrl = existingUrl;

        const fileInput      = document.getElementById(`file-input-${slot}`);
        const hiddenInput    = document.getElementById(`hidden-url-${slot}`);
        const status         = document.getElementById(`status-${slot}`);
        const previewWrapper = document.getElementById(`preview-wrapper-${slot}`);
        const previewImg     = document.getElementById(`preview-${slot}`);
        const removeBtn      = document.getElementById(`remove-btn-${slot}`);
        const submitBtn      = document.getElementById('submit-btn');

        if (committedUrl) {
            hiddenInput.value = committedUrl;
            previewImg.src = committedUrl;
            previewWrapper.classList.remove('d-none');
        }

        fileInput.addEventListener('change', async () => {
            const file = fileInput.files[0];
            if (!file) return;

            previewImg.src = URL.createObjectURL(file);
            previewWrapper.classList.remove('d-none');
            status.textContent = msgUploading;
            status.className = 'text-muted small';
            submitBtn.disabled = true;

            const formData = new FormData();
            formData.append('file', file);

            try {
                const res = await fetch('/Image/Upload', { method: 'POST', body: formData });
                if (!res.ok) throw new Error(await res.text());

                const data = await res.json();
                committedUrl = data.url;
                hiddenInput.value = data.url;
                previewImg.src = data.url;
                status.textContent = msgUploaded;
                status.className = 'text-success small';
            } catch (err) {
                status.textContent = msgUploadFailed + ' ' + err.message;
                status.className = 'text-danger small';
                previewWrapper.classList.add('d-none');
                previewImg.src = committedUrl ?? '';
                hiddenInput.value = committedUrl ?? '';
            } finally {
                submitBtn.disabled = false;
            }
        });

        removeBtn.addEventListener('click', () => {
            committedUrl = null;
            hiddenInput.value = '';
            previewWrapper.classList.add('d-none');
            previewImg.src = '';
            status.textContent = '';
            status.className = 'text-muted small';
        });
    }

    @{
        var inv = ViewBag.Inventory as Inventory;
        foreach (var f in inv.Fields.OrderBy(f => f.Order).Where(f => f.Type == FieldType.Link))
        {
            var prop = Model.GetType().GetProperty(f.Slot);
            var val = prop?.GetValue(Model)?.ToString();
            <text>initLinkUpload('@f.Slot', @Json.Serialize(val));</text>
        }
    }
</script>
}
