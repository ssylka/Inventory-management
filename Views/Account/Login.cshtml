<form method="post" class="mt-4" style="max-width: 400px;">
    <h3 class="mb-4">@Localizer["LogIn"]</h3>

    <div class="mb-3">
        <label class="form-label">@Localizer["Email"]</label>
        <input name="email" class="form-control" placeholder="@Localizer["EnterEmail"]" type="email" />
    </div>

    <div class="mb-3">
        <label class="form-label">@Localizer["Password"]</label>
        <input name="password" type="password" class="form-control" placeholder="@Localizer["EnterPassword"]" />
    </div>

    <div class="mb-3 d-flex align-items-center gap-2">
        <a class="btn btn-outline-danger" href="/Account/ExternalLogin?provider=Google">
            @Localizer["LoginWithGoogle"] <img style="height:1.5em" src="https://cdn-icons-png.flaticon.com/512/300/300221.png" />
        </a>
        <a class="btn btn-outline-secondary" href="/Account/ExternalLogin?provider=GitHub">
            @Localizer["LoginWithGitHub"]
            <img style="height:1.5em"
                 src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/c2/GitHub_Invertocat_Logo.svg/960px-GitHub_Invertocat_Logo.svg.png" />
        </a>
    </div>

    <button type="submit" class="btn btn-primary w-100">@Localizer["LogIn"]</button>
</form>

<div asp-validation-summary="All" class="text-danger mt-3"></div>
