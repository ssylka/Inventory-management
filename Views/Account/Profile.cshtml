@using Inventory_Managment.Models
@model Inventory_Managment.Models.Dto.ProfileViewModel

@{
    ViewData["Title"] = Model.User.Name;
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h2 class="mb-0">@Localizer["NameIs"] @Model.User.Name</h2>
        <p class="text-muted mb-0">@Localizer["EmailLabel"] @Model.User.Email</p>
        @if (Model.User.EmailConfirmed)
        {
            <p class="text-success">@Localizer["EmailConfirmed"]</p>
        }
        else
        {
            <p class="text-danger">@Localizer["EmailNotConfirmed"]</p>
        }
        <p>@Localizer["RoleIs"] <b>@Model.Role</b></p>
    </div>
</div>

<h5 class="mt-4">@Localizer["MyInventories"]</h5>

<div class="mb-2 d-flex gap-2 align-items-center">
    <input id="owned-filter" class="form-control form-control-sm" style="max-width:260px" placeholder="@Localizer["FilterByTitle"]" />
    <select id="owned-sort" class="form-select form-select-sm" style="max-width:180px">
        <option value="title-asc">@Localizer["TitleAZ"]</option>
        <option value="title-desc">@Localizer["TitleZA"]</option>
        <option value="date-desc">@Localizer["NewestFirst"]</option>
        <option value="date-asc">@Localizer["OldestFirst"]</option>
    </select>
    @if (Model.IsOwnProfile)
    {
        <button id="owned-delete-btn" class="btn btn-danger btn-sm d-none">@Localizer["DeleteSelected"]</button>
    }
</div>

<table class="table table-bordered table-striped align-middle text-center" id="owned-table">
    <thead>
        <tr>
            @if (Model.IsOwnProfile)
            {
                <th style="width:5%">
                    <input type="checkbox" class="btn-check" id="owned-select-all">
                    <label class="btn btn-outline-secondary btn-sm" for="owned-select-all">@Localizer["All"]</label>
                </th>
            }
            <th>@Localizer["Title"]</th>
            <th>@Localizer["Description"]</th>
            <th>@Localizer["Public"]</th>
            <th>@Localizer["Created"]</th>
        </tr>
    </thead>
    <tbody id="owned-tbody">
        @foreach (var inv in Model.OwnedInventories)
        {
            <tr data-id="@inv.Id"
                data-title="@inv.Title.ToLower()"
                data-date="@inv.CreatedAt.Ticks"
                onclick="window.location='/Inventory/Details/@inv.Id'"
                style="cursor:pointer">
                @if (Model.IsOwnProfile)
                {
                    <td onclick="event.stopPropagation()">
                        <input class="form-check-input owned-checkbox" type="checkbox" value="@inv.Id" />
                    </td>
                }
                <td>@inv.Title</td>
                <td class="text-muted">@inv.Description</td>
                <td><input class="form-check-input" type="checkbox" @(inv.IsPublic ? "checked" : "") disabled /></td>
                <td>@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.OwnedInventories.Any())
{
    <p class="text-muted">@Localizer["NoInventoriesYet"]</p>
}

<h5 class="mt-5">@Localizer["WriteAccess"]</h5>

<div class="mb-2 d-flex gap-2 align-items-center">
    <input id="access-filter" class="form-control form-control-sm" style="max-width:260px" placeholder="@Localizer["FilterByTitle"]" />
    <select id="access-sort" class="form-select form-select-sm" style="max-width:180px">
        <option value="title-asc">@Localizer["TitleAZ"]</option>
        <option value="title-desc">@Localizer["TitleZA"]</option>
        <option value="date-desc">@Localizer["NewestFirst"]</option>
        <option value="date-asc">@Localizer["OldestFirst"]</option>
    </select>
</div>

<table class="table table-bordered table-striped align-middle text-center" id="access-table">
    <thead>
        <tr>
            <th>@Localizer["Title"]</th>
            <th>@Localizer["Description"]</th>
            <th>@Localizer["Public"]</th>
            <th>@Localizer["Created"]</th>
        </tr>
    </thead>
    <tbody id="access-tbody">
        @foreach (var inv in Model.AccessInventories)
        {
            <tr data-id="@inv.Id"
                data-title="@inv.Title.ToLower()"
                data-date="@inv.CreatedAt.Ticks"
                onclick="window.location='/Inventory/Details/@inv.Id'"
                style="cursor:pointer">
                <td>@inv.Title</td>
                <td class="text-muted">@inv.Description</td>
                <td><input class="form-check-input" type="checkbox" @(inv.IsPublic ? "checked" : "") disabled /></td>
                <td>@inv.CreatedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
    </tbody>
</table>
@if (!Model.AccessInventories.Any())
{
    <p class="text-muted">@Localizer["NoInventoriesWithAccess"]</p>
}
@if (Model.IsOwnProfile)
{
    <a asp-controller="Inventory" asp-action="Create" class="btn btn-primary">@Localizer["NewInventory"]</a>
}
@section Scripts {
<script>
    function applyFilterSort(tbodyId, filterVal, sortVal) {
        const tbody = document.getElementById(tbodyId);
        const rows = Array.from(tbody.querySelectorAll("tr"));

        const term = filterVal.toLowerCase();
        rows.forEach(r => {
            r.style.display = r.dataset.title.includes(term) ? "" : "none";
        });

        const visible = rows.filter(r => r.style.display !== "none");
        visible.sort((a, b) => {
            switch (sortVal) {
                case "title-asc":  return a.dataset.title.localeCompare(b.dataset.title);
                case "title-desc": return b.dataset.title.localeCompare(a.dataset.title);
                case "date-asc":   return Number(a.dataset.date) - Number(b.dataset.date);
                case "date-desc":  return Number(b.dataset.date) - Number(a.dataset.date);
            }
        });
        visible.forEach(r => tbody.appendChild(r));
    }

    const ownedFilter = document.getElementById("owned-filter");
    const ownedSort   = document.getElementById("owned-sort");
    function refreshOwned() { applyFilterSort("owned-tbody", ownedFilter.value, ownedSort.value); }
    ownedFilter?.addEventListener("input", refreshOwned);
    ownedSort?.addEventListener("change", refreshOwned);

    const accessFilter = document.getElementById("access-filter");
    const accessSort   = document.getElementById("access-sort");
    function refreshAccess() { applyFilterSort("access-tbody", accessFilter.value, accessSort.value); }
    accessFilter?.addEventListener("input", refreshAccess);
    accessSort?.addEventListener("change", refreshAccess);

    const deleteBtn = document.getElementById("owned-delete-btn");
    const selectAll = document.getElementById("owned-select-all");

    document.getElementById("owned-tbody")?.addEventListener("change", e => {
        if (!e.target.classList.contains("owned-checkbox")) return;
        const anyChecked = document.querySelectorAll(".owned-checkbox:checked").length > 0;
        deleteBtn?.classList.toggle("d-none", !anyChecked);
    });

    selectAll?.addEventListener("change", function () {
        document.querySelectorAll(".owned-checkbox").forEach(cb => cb.checked = this.checked);
        const anyChecked = document.querySelectorAll(".owned-checkbox:checked").length > 0;
        deleteBtn?.classList.toggle("d-none", !anyChecked);
    });

    deleteBtn?.addEventListener("click", async () => {
        const ids = Array.from(document.querySelectorAll(".owned-checkbox:checked"))
            .map(cb => Number(cb.value));
        if (!ids.length) return;
        const res = await fetch('/Inventory/Delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(ids)
        });
        if (res.ok) location.reload();
        else alert(await res.text());
    });
</script>
}
