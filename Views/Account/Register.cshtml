@if (ViewBag.EmailSent == true)
{
    <div class="mt-4" style="max-width:400px">
        <div class="alert alert-success">
            <h5>@Localizer["CheckYourEmail"]</h5>
            <p>@Localizer["ConfirmationSent"]</p>
        </div>
        <a href="/Account/Login" class="btn btn-outline-primary">@Localizer["GoToLogin"]</a>
    </div>
}
else
{
    <form method="post" class="mt-4" style="max-width: 400px;">
        <h3 class="mb-4">@Localizer["Register"]</h3>

        <div class="mb-3">
            <label class="form-label">@Localizer["Email"]</label>
            <input name="email" class="form-control" placeholder="@Localizer["EnterEmail"]" type="email" required />
            @Html.ValidationMessage("email", "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Password"]</label>
            <input name="password" type="password" class="form-control" placeholder="@Localizer["EnterPassword"]" required />
            @Html.ValidationMessage("password", "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3">
            <label class="form-label">@Localizer["Name"]</label>
            <input name="name" class="form-control" placeholder="@Localizer["EnterName"]" required />
            @Html.ValidationMessage("name", "", new { @class = "text-danger small" })
        </div>

        <div class="mb-3 d-flex align-items-center gap-2">
            <a class="btn btn-outline-danger" href="/Account/ExternalLogin?provider=Google">
                @Localizer["LoginWithGoogle"] <img style="height:1.5em" src="https://cdn-icons-png.flaticon.com/512/300/300221.png" />
            </a>
             <a class="btn btn-outline-primary" href="/Account/ExternalLogin?provider=Facebook">
                @Localizer["LoginWithFacebook"] <img style="height:1.5em" src="https://upload.wikimedia.org/wikipedia/commons/5/51/Facebook_f_logo_%282019%29.svg" />
            </a> 
            <a class="btn btn-outline-secondary" href="/Account/ExternalLogin?provider=GitHub">
                @Localizer["LoginWithGitHub"]
                <img style="height:1.5em"
                     src="https://github.githubassets.com/images/modules/logos_page/GitHub-Mark.png" />
            </a>
        </div>

        <button type="submit" class="btn btn-primary w-100">@Localizer["Register"]</button>
    </form>

    <div asp-validation-summary="ModelOnly" class="text-danger mt-3"></div>
}
