@model List<Inventory>

<h2>Inventories</h2>
<table class="table table-striped table-hover align-middle text-center">
    <thead>
        <tr>
            <th style="width:5%">
                <input type="checkbox" class="btn-check" id="btn-check-outlined">
                <label class="btn btn-outline-secondary btn-sm" for="btn-check-outlined">All</label>
            </th>
            <th class="w-25 fs-2">Title</th>
            <th style="width:70%" class="fs-2">Description</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inv in Model)
        {
            <tr>
                <td><input class="form-check-input" type="checkbox" value="@inv.Id"/></td>
                <td class="inventory-row border" style="cursor:pointer;" data-id="@inv.Id">@inv.Title</td>
                <td class="inventory-row markup" style="cursor:pointer;" data-id="@inv.Id">@inv.Description</td>
            </tr>
        }
    </tbody>
</table>

<a href="/Inventory/Create" class="btn btn-primary">Create</a>
<a class="btn btn-danger" id="btnDelete">Delete</a>

<script src="~/js/index_inventory.js" asp-append-version="true"></script>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/dompurify@3/dist/purify.min.js"></script>
<script>    
    // get every Description
    let lables = document.querySelectorAll(".markup");
    lables.forEach(t => {
        let text = t.textContent.trim();
        text = DOMPurify.sanitize(marked.parse(text))
        t.innerHTML = text;
        }
    );
</script>
